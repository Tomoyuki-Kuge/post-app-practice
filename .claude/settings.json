{
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail artisan test)",
      "Bash(sail artisan test)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/ensure-tests-pass.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/ensure-tests-pass.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
